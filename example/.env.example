ALERTSNITCH_ADDR=:9567
ALERTSNITCH_DEBUG=true
ALERTSNITCH_BACKEND=loki
ALERTSNITCH_BACKEND_ENDPOINT=http://loki:3100


# mysql
# ALERTSNITCH_BACKEND_ENDPOINT=user:password@tcp(mysql:3306)/dbname
# ALERTSNITCH_MAX_OPEN_CONNS=2
# ALERTSNITCH_MAX_IDLE_CONNS=1
# ALERTSNITCH_MAX_CONN_LIFETIME=600

# optional
ALERTSNITCH_LOKI_TENANT_ID=tenant_1
ALERTSNITCH_LOKI_BASIC_AUTH_USER=user
ALERTSNITCH_LOKI_BASIC_AUTH_PASSWORD=password

ALERTSNITCH_LOKI_BATCH_ENABLED=true
ALERTSNITCH_LOKI_BATCH_SIZE=100
ALERTSNITCH_LOKI_BATCH_FLUSH_TIMEOUT=5s
ALERTSNITCH_LOKI_BATCH_MAX_RETRIES=3

# Stream labels: override the low-cardinality default allow-list if needed.
# Do NOT add high-cardinality labels (instance, pod, node, container) here.
# ALERTSNITCH_LOKI_ALLOWED_LABELS=severity,priority,env

# Structured metadata (opt-in): promote fingerprint + high-card labels to Loki
# structured metadata. Requires a Loki 3.x TSDB schema v13+.
# ALERTSNITCH_LOKI_STRUCTURED_METADATA=true

# Write-ahead log (opt-in): crash-durable batch buffering. Requires batch mode.
# WAL_DIR should be a persistent path so buffered alerts survive a restart.
# ALERTSNITCH_LOKI_WAL_ENABLED=true
# ALERTSNITCH_LOKI_WAL_DIR=/var/lib/alertsnitch/wal

# HolmesGPT
OPENAI_API_KEY=
MODEL=gpt-4.1